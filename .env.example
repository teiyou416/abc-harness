# Copy to .env and fill in. .env is gitignored and never enters a container,
# a trace, or an artifact. Every API key the harness needs lives here.

# Claude API key for the agent loop (abc-harness ask). Required.
ANTHROPIC_API_KEY=

# DeepSeek API key, for --model deepseek-v4-pro or deepseek-flash (and /model in
# chat). Optional: without it only the Claude models are available.
DEEPSEEK_API_KEY=

# Semantic Scholar API key for literature search. Optional: without it the
# agent searches OpenAlex only, which filters the FC venue less reliably.
# Free key: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
