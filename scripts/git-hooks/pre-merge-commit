#!/bin/sh
# Run the full local check before a merge commit lands on dev or main.
# A fast-forward merge skips this hook, so always merge with --no-ff.
# See docs/context/conventions.md section 5.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main|dev)
    echo "pre-merge-commit: running make check before merging into '$branch'" >&2
    make check || {
      echo "pre-merge-commit: make check failed; the merge into '$branch' is aborted." >&2
      exit 1
    }
    ;;
esac
exit 0
