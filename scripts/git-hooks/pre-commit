#!/bin/sh
# Refuse direct commits on protected branches. Work happens on a branch cut
# from dev and arrives on dev or main only through `git merge --no-ff`.
# See docs/context/conventions.md section 5.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main|dev)
    echo "pre-commit: direct commits on '$branch' are not allowed." >&2
    echo "Create a branch from dev: git switch dev && git switch -c feature/<name>" >&2
    exit 1
    ;;
esac
exit 0
